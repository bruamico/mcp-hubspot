# Dockerfile for the Slack Agent
# Build: docker build -f Dockerfile.slack -t tropical-slack-agent .
# Fly.io deploy: fly deploy --config fly.slack.toml

FROM python:3.11-slim

WORKDIR /app

# Install all dependencies (Slack agent + HubSpot client, excluding heavy ML deps)
COPY requirements-slack.txt ./
RUN pip install --no-cache-dir -r requirements-slack.txt

# Copy only the HubSpot clients (no FAISS/embedding model needed for Slack agent)
COPY src/ ./src/
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --no-deps -e .

# Copy agent code
COPY slack_agent/ ./slack_agent/

# Data directory for SQLite volume mount
RUN mkdir -p /app/data

EXPOSE 8080

CMD ["python", "-m", "slack_agent.app"]
